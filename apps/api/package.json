{
  "name": "@hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "rm -rf dist && echo 'API runs directly from source'",
    "start": "rm -rf dist && bun src/index.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.3.2",
    "@hub/shared": "workspace:*",
    "@libsql/client": "^0.14.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^1.8.3",
    "@trpc/server": "^11.0.0-rc.592",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.11",
    "lucia": "^3.2.1",
    "node-html-parser": "^7.0.1",
    "oslo": "^1.2.1",
    "valibot": "^0.42.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  }
}
