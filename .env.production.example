# ==========================================
# Production Environment Variables
# ==========================================

# ===== API Container (apps/api) =====
DATABASE_URL=file:/data/production.db
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://hub.reneschmidt.de

# ===== Web Container (apps/web) =====
NEXT_PUBLIC_API_URL=https://hub-api.reneschmidt.de
NODE_ENV=production

# ==========================================
# Coolify Setup Instructions
# ==========================================
#
# 1. In Coolify, set these env vars für beide Container
# 2. API Container braucht Volume Mount:
#    - Host Path: /mnt/storage/degixhub/data
#    - Container Path: /data
#    - Für SQLite Database Persistence
#
# 3. Generate ENCRYPTION_KEY:
#    openssl rand -hex 32
#
# 4. Domains in Coolify konfigurieren:
#    - Web: hub.reneschmidt.de
#    - API: hub-api.reneschmidt.de
#
# 5. HTTPS wird automatisch von Traefik gehandelt
#
# ==========================================
